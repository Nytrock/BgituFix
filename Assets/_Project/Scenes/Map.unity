  m_text: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u043E \u043A\u0430\u0440\u0442\u0435
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u043C\u044B\u0448\u0438\n\n\u0414\u043B\u044F \u0432\u044B\u0431\u043E\u0440\u0430
    \u043E\u0434\u043D\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0430
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0433\u043E
    \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438\n\n\u0414\u043B\u044F
    \u0432\u044B\u0431\u043E\u0440\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    \u043A\u0430\u0440\u0442\u044B \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u043C\u044B\u0448\u0438 \u0438 \u0441 \u0437\u0430\u0436\u0430\u0442\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u0435
    \u043D\u0443\u0436\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B\n\n\u0414\u043B\u044F
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0437\u0430\u0436\u043C\u0438\u0442\u0435
    \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
    \u043D\u0430\u0434 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C \u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438
    \u043C\u044B\u0448\u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0435 \u0435\u0433\u043E
    \u043F\u043E\u0437\u0438\u0446\u0438\u044E\n\n\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430
    \u043F\u043E\u0442\u044F\u043D\u0438\u0442\u0435 \u0437\u0430  \u0440\u0430\u043C\u043A\u0443
    \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0443 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430\n\n\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u043E\u0431 \u043E\u0431\u044A\u0435\u043A\u0442\u0435
    \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u0435 \u043D\u0443\u0436\u043D\u044B\u0439
    \u043E\u0431\u044A\u0435\u043A\u0442 \u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0435
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0432 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u0439\u0441\u044F
    \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u043F\u0440\u0430\u0432\u043E\u043C
    \u0443\u0433\u043B\u0443 \u043F\u0430\u043D\u0435\u043B\u0438\n\n\u041D\u0435\u043B\u044C\u0437\u044F
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0438\u043B\u0438
    \u0440\u0430\u0437\u043C\u0435\u0440 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432, \u043D\u043E \u043C\u043E\u0436\u043D\u043E
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u0445 \u043F\u043E\u0437\u0438\u0446\u0438\u044E\n\n\u0414\u043B\u044F
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u044F
    \u043A \u043A\u043D\u043E\u043F\u043A\u0430\u043C \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430
    \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043D\u0443\u0436\u043D\u0443\u044E
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0438 \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435"
